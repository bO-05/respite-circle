# Copy to .env.local and fill in. NEVER commit .env.local.
# --- Model provider ---
MISTRAL_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=8000
RC_MODEL=mistral-small-latest
# --- Database (Neon Postgres) ---
# Pooled connection string (host contains -pooler) used by the app at runtime.
DATABASE_URL=
# Direct connection string used by drizzle-kit migrations, seed, and calibration runs.
DATABASE_URL_UNPOOLED=
# --- Test database ---
# A second Neon branch named `e2e`, created once from `main`.
# The Vitest integration layer and the Playwright suite truncate tables, so they
# refuse to run without these, and `RC_DB_BRANCH=e2e` must be set alongside them.
E2E_DATABASE_URL=
E2E_DATABASE_URL_UNPOOLED=
# Must equal `e2e` when the integration or Playwright suites run; they abort
# without it so a suite can never truncate the demo branch.
RC_DB_BRANCH=
# Opt in to the one live-provider smoke test. Leave empty for every gate run.
RC_LIVE_MODEL=
# --- Session and demo ---
SESSION_SECRET=change-me-to-a-long-random-value
RC_DEMO_MODE=true
RC_DEMO_RESET_TOKEN=
RC_SEED_ALLOW_REMOTE=
# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3130

{
  "name": "respite-circle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3130",
    "build": "next build",
    "start": "next start -p 3130",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --pool=forks --maxWorkers=2 && vitest run --config vitest.integration.config.ts --pool=forks --maxWorkers=1",
    "test:unit": "vitest run --config vitest.unit.config.ts --pool=forks --maxWorkers=2",
    "test:integration": "vitest run --config vitest.integration.config.ts --pool=forks --maxWorkers=1",
    "test:e2e": "playwright test --workers=1",
    "calibrate": "npx tsx scripts/calibrate.ts",
    "calibrate:baseline": "npx tsx scripts/calibrate.ts --baseline",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx tsx scripts/db-migrate.ts",
    "db:migrate:remote": "npx tsx scripts/db-migrate.ts --remote",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:seed:remote": "npx tsx src/db/seed.ts --remote",
    "db:reset": "npx tsx scripts/reset-demo.ts",
    "db:verify": "npx tsx scripts/verify-seed.ts",
    "sessions:materialise": "npx tsx scripts/materialise-sessions.ts",
    "sessions:materialise:e2e": "npx tsx scripts/materialise-sessions.ts --e2e"
  },
  "dependencies": {
    "@ai-sdk/mistral": "4.0.89",
    "@ai-sdk/openai-compatible": "3.0.94",
    "ai": "7.0.179",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}

# Copy to .env.local and fill in. NEVER commit .env.local.
# --- Model provider ---
MISTRAL_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=8000
RC_MODEL=mistral-small-latest
# Typed-decision provider override. Leave empty for `auto`
# (MISTRAL_API_KEY -> HF_TOKEN -> OPENROUTER_API_KEY -> deterministic).
# `fake` is the test-only deterministic path for Playwright; it never calls out.
RC_AI_PROVIDER=
# Per-call timeout for the decision service; a timeout is retried once, then the
# labelled deterministic engine completes the result. Falls back to LLM_TIMEOUT_MS.
RC_AI_TIMEOUT_MS=8000
# Fallback model ids (only used when their key is the selected provider).
RC_HF_MODEL=
RC_OPENROUTER_MODEL=
# --- Database (Neon Postgres) ---
# Pooled connection string (host contains -pooler) used by the app at runtime.
DATABASE_URL=
# Direct connection string used by drizzle-kit migrations, seed, and calibration runs.
DATABASE_URL_UNPOOLED=
# --- Test database ---
# A separate database, `respite_circle_e2e`, created once in the SAME Neon project
# and branch as the app database `neondb` (not a Neon branch). The Vitest integration
# layer and the Playwright suite truncate tables, so they refuse to run without these.
# Take the two strings above and change only the database name in the path:
#   pooled  -> E2E_DATABASE_URL            (same -pooler host as DATABASE_URL)
#   direct  -> E2E_DATABASE_URL_UNPOOLED   (same direct host as DATABASE_URL_UNPOOLED)
# The two E2E strings differ from each other only by the -pooler host, and from the
# app's strings only by the database name.
E2E_DATABASE_URL=
E2E_DATABASE_URL_UNPOOLED=
# Must equal `e2e` when the integration or Playwright suites run; they abort
# without it so a suite can never truncate `neondb`. Despite the name this is an
# isolation flag naming the target database, not a Neon branch.
RC_DB_BRANCH=
# Opt in to the one live-provider smoke test. Leave empty for every gate run.
RC_LIVE_MODEL=
# Calibration runner source: `live` or `deterministic-baseline`. Empty = auto
# (live when a provider key is present, baseline otherwise).
RC_CALIBRATION_SOURCE=
# Test-only switches. Never set either in Vercel.
# `1` enables the /error-probe route used by the Playwright 500 check.
RC_E2E=
# `1` makes Playwright reuse an already-running local server.
PW_REUSE=
# --- Session and demo ---
SESSION_SECRET=change-me-to-a-long-random-value
RC_DEMO_MODE=true
RC_DEMO_RESET_TOKEN=
# CLI-only: `1` confirms a deliberate migrate, seed, or reset of the remote app
# database. Never set this in Vercel; the deployed app never writes schema.
RC_SEED_ALLOW_REMOTE=
# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3130
